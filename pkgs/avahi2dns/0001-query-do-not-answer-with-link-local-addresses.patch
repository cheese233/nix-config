+// browseAddresses returns every address avahi holds for name, sorted so that
+// repeated lookups of a multi-homed host answer deterministically.
+func (me *forwarder) browseAddresses(ctx context.Context, name string, proto int32) []string {
+	recordType, ok := recordTypeFor(proto)
+	if !ok {
+		return nil
+	}
+
+	browser, err := me.avahi.RecordBrowserNew(
+		avahi.InterfaceUnspec,
+		proto,
+		strings.TrimSuffix(name, "."),
+		int16(dns.ClassINET),
+		recordType,
+		0,
+	)
+	if err != nil {
+		me.logger.WithError(err).WithField("name", name).Warning("failed to browse avahi address records")
+		return nil
+	}
+	defer me.avahi.RecordBrowserFree(browser)
+
+	addresses := make(map[string]struct{})
+	var (
+		settle  *time.Timer
+		settleC <-chan time.Time
+	)
+
+	timeout := time.NewTimer(browseTimeout)
+	defer timeout.Stop()
+
+	for {
+		select {
+		case record, ok := <-browser.AddChannel:
+			if !ok {
+				return sortedAddresses(addresses)
+			}
+			address := addressFromRecord(proto, record.Rdata)
+			if address == "" {
+				continue
+			}
+			if _, known := addresses[address]; known {
+				continue
+			}
+			addresses[address] = struct{}{}
+			if settle == nil {
+				settle = time.NewTimer(browseSettle)
+				settleC = settle.C
+				defer settle.Stop()
+			} else {
+				settle.Reset(browseSettle)
+			}
+
+		case <-settleC:
+			return sortedAddresses(addresses)
+
+		case <-timeout.C:
+			return sortedAddresses(addresses)
+
+		case <-ctx.Done():
+			return sortedAddresses(addresses)
+		}
+	}
+}
+
+func recordTypeFor(proto int32) (int16, bool) {
+	switch proto {
+	case avahi.ProtoInet:
+		return int16(dns.TypeA), true
+	case avahi.ProtoInet6:
+		return int16(dns.TypeAAAA), true
+	default:
+		return 0, false
+	}
+}
+
+func addressFromRecord(proto int32, rdata []byte) string {
+	switch proto {
+	case avahi.ProtoInet:
+		if len(rdata) != net.IPv4len {
+			return ""
+		}
+	case avahi.ProtoInet6:
+		if len(rdata) != net.IPv6len {
+			return ""
+		}
+	default:
+		return ""
+	}
+	return net.IP(rdata).String()
+}
+
+// isLinkLocal reports whether address is link-local, i.e. in fe80::/10 (or its
+// IPv4 counterpart 169.254.0.0/16). Records in that range only carry meaning
+// on the link they were announced on, so answering with one gives clients an
+// address they cannot connect to.
+func isLinkLocal(address string) bool {
+	ip := net.ParseIP(address)
+	return ip != nil && ip.IsLinkLocalUnicast()
+}
+
+func sortedAddresses(addresses map[string]struct{}) []string {
+	sorted := make([]string, 0, len(addresses))
+	for address := range addresses {
+		sorted = append(sorted, address)
+	}
+	sort.Strings(sorted)
+	return sorted
+}
