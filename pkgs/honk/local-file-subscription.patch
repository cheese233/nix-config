+fn local_file_path(subscription_url: &str) -> anyhow::Result<Option<PathBuf>> {
+    let url = Url::parse(subscription_url)
+        .with_context(|| format!("invalid subscription URL '{}'; expected a URL", subscription_url))?;
+    if url.scheme() != "file" {
+        return Ok(None);
+    }
+
+    anyhow::ensure!(
+        url.username().is_empty()
+            && url.password().is_none()
+            && url.query().is_none()
+            && url.fragment().is_none(),
+        "file subscription URL must not contain credentials, a query, or a fragment"
+    );
+
+    // Accept the standard absolute form and dae's legacy `file://relative`
+    // form. Remote file authorities are deliberately not supported.
+    if let Some(host) = url.host_str()
+        && host != "localhost"
+        && url.path().is_empty()
+    {
+        return Ok(Some(PathBuf::from(host)));
+    }
+
+    let path = url
+        .to_file_path()
+        .map_err(|()| anyhow::anyhow!("invalid local file subscription URL '{subscription_url}'"))?;
+    Ok(Some(path))
+}
