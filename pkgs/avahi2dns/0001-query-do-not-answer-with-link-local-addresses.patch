+	"github.com/miekg/dns"
+)
+
+const (
+	avahiBusName = "org.freedesktop.Avahi"
+	avahiBusPath = "/"
+
+	// addressSettle is how long a record browse waits for one more address
+	// record once it has seen one; addressTimeout caps a whole browse.
+	addressSettle  = 200 * time.Millisecond
+	addressTimeout = 2 * time.Second
 )
 
 //go:generate go tool mockery
@@ -13,6 +29,7 @@ import (
 type avahiClient interface {
 	io.Closer
 	ResolveHostName(iface, protocol int32, name string, aprotocol int32, flags uint32) (avahi.HostName, error)
+	AddressRecords(ctx context.Context, proto int32, name string) ([]string, error)
 }
 
 type avahiConn struct {
@@ -32,14 +49,162 @@ func newAvahiClient() (avahiClient, error) {
 		return nil, fmt.Errorf("connection to avahi failed: %w", err)
 	}
 
-	return &avahiConn{dbus: conn, server: server}, nil
+	return &avahiConn{
+		dbus:   conn,
+		server: server,
+	}, nil
 }
 
 func (me *avahiConn) ResolveHostName(iface, protocol int32, name string, aprotocol int32, flags uint32) (avahi.HostName, error) {
 	return me.server.ResolveHostName(iface, protocol, name, aprotocol, flags)
 }
 
+// AddressRecords returns every address avahi knows for name under proto
+// (avahi.ProtoInet or avahi.ProtoInet6). ResolveHostName only ever exposes a
+// single address per host, so a record browser is used to see all of them.
+//
+// The browser runs on its own bus connection: go-avahi hands the shared
+// connection's signals to its Server, and its RecordBrowserNew marshals the
+// class and type as int16 while avahi expects uint16 ("iisqqu").
+func (me *avahiConn) AddressRecords(ctx context.Context, proto int32, name string) ([]string, error) {
+	recordType, ok := recordTypeFor(proto)
+	if !ok {
+		return nil, fmt.Errorf("unsupported protocol: %d", proto)
+	}
+
+	conn, err := dbus.SystemBusPrivate()
+	if err != nil {
+		return nil, fmt.Errorf("connection to dbus failed: %w", err)
+	}
+	defer conn.Close()
+
+	if err := conn.Auth(nil); err != nil {
+		return nil, fmt.Errorf("dbus authentication failed: %w", err)
+	}
+	if err := conn.Hello(); err != nil {
+		return nil, fmt.Errorf("dbus hello failed: %w", err)
+	}
+
+	signals := make(chan *dbus.Signal, 64)
+	conn.Signal(signals)
+
+	if err := conn.AddMatchSignal(dbus.WithMatchInterface("org.freedesktop.Avahi.RecordBrowser")); err != nil {
+		return nil, fmt.Errorf("dbus signal match failed: %w", err)
+	}
+
+	var path dbus.ObjectPath
+	err = conn.Object(avahiBusName, avahiBusPath).Call(
+		avahiBusName+".Server.RecordBrowserNew", 0,
+		avahi.InterfaceUnspec,
+		proto,
+		strings.TrimSuffix(name, "."),
+		uint16(dns.ClassINET),
+		uint16(recordType),
+		uint32(0),
+	).Store(&path)
+	if err != nil {
+		return nil, fmt.Errorf("failed to browse address records: %w", err)
+	}
+	defer func() {
+		_ = conn.Object(avahiBusName, path).Call(avahiBusName+".RecordBrowser.Free", 0).Err
+	}()
+
+	addresses := make(map[string]struct{})
+	var (
+		settle  *time.Timer
+		settleC <-chan time.Time
+	)
+
+	timeout := time.NewTimer(addressTimeout)
+	defer timeout.Stop()
+
+	for {
+		select {
+		case signal, ok := <-signals:
+			if !ok {
+				return sortedAddresses(addresses), nil
+			}
+			if signal.Path != path || signal.Name != avahiBusName+".RecordBrowser.ItemNew" {
+				continue
+			}
+
+			var (
+				iface, protocol int32
+				recordName      string
+				class, gotType  uint16
+				rdata           []byte
+				flags           uint32
+			)
+			if err := dbus.Store(signal.Body, &iface, &protocol, &recordName, &class, &gotType, &rdata, &flags); err != nil {
+				continue
+			}
+
+			address := addressFromRecord(proto, rdata)
+			if address == "" {
+				continue
+			}
+			if _, known := addresses[address]; known {
+				continue
+			}
+			addresses[address] = struct{}{}
+
+			if settle == nil {
+				settle = time.NewTimer(addressSettle)
+				settleC = settle.C
+				defer settle.Stop()
+			} else {
+				settle.Reset(addressSettle)
+			}
+
+		case <-settleC:
+			return sortedAddresses(addresses), nil
+
+		case <-timeout.C:
+			return sortedAddresses(addresses), nil
+
+		case <-ctx.Done():
+			return sortedAddresses(addresses), ctx.Err()
+		}
+	}
+}
+
 func (me *avahiConn) Close() error {
 	me.server.Close()
 	return me.dbus.Close()
 }
+
+func recordTypeFor(proto int32) (int16, bool) {
+	switch proto {
+	case avahi.ProtoInet:
+		return int16(dns.TypeA), true
+	case avahi.ProtoInet6:
+		return int16(dns.TypeAAAA), true
+	default:
+		return 0, false
+	}
+}
+
+func addressFromRecord(proto int32, rdata []byte) string {
+	switch proto {
+	case avahi.ProtoInet:
+		if len(rdata) != net.IPv4len {
+			return ""
+		}
+	case avahi.ProtoInet6:
+		if len(rdata) != net.IPv6len {
+			return ""
+		}
+	default:
+		return ""
+	}
+	return net.IP(rdata).String()
+}
+
+func sortedAddresses(addresses map[string]struct{}) []string {
+	sorted := make([]string, 0, len(addresses))
+	for address := range addresses {
+		sorted = append(sorted, address)
+	}
+	sort.Strings(sorted)
+	return sorted
+}
