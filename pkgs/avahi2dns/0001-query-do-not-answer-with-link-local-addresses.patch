+// doAvahiRequest resolves name to one address that a unicast DNS client can
+// actually use. Avahi's ResolveHostName answers with a single address, picked
+// from whichever address record it saw first, so a host that announces both a
+// routable and a link-local IPv6 address regularly ends up resolving to the
+// link-local one. Those are scoped to a single link, so in that case the whole
+// record set is browsed instead and the first routable address is answered.
 func (me *forwarder) doAvahiRequest(ctx context.Context, name string, proto int32) (string, error) {
+	address, err := me.resolveHostName(ctx, name, proto)
+	if err == nil && address != "" && !isLinkLocal(address) {
+		return address, nil
+	}
+
+	addresses, browseErr := me.avahi.AddressRecords(ctx, proto, name)
+	if browseErr != nil {
+		me.logger.WithError(browseErr).WithField("name", name).Warning("failed to browse avahi address records")
+	}
+	for _, candidate := range addresses {
+		if !isLinkLocal(candidate) {
+			return candidate, nil
+		}
+	}
+
+	if err != nil {
+		return "", err
+	}
+	return "", fmt.Errorf("no routable address for %s (avahi only offered %v)", name, addresses)
+}
+
+func (me *forwarder) resolveHostName(ctx context.Context, name string, proto int32) (string, error) {
 	type avahiResult struct {
 		address string
 		err     error
@@ -139,3 +168,12 @@ func (me *forwarder) doAvahiRequest(ctx context.Context, name string, proto int3
 		return result.address, nil
 	}
 }
+
+// isLinkLocal reports whether address is link-local, i.e. in fe80::/10 (or its
+// IPv4 counterpart 169.254.0.0/16). Records in that range only carry meaning
+// on the link they were announced on, so answering with one gives clients an
+// address they cannot connect to.
+func isLinkLocal(address string) bool {
+	ip := net.ParseIP(address)
+	return ip != nil && ip.IsLinkLocalUnicast()
+}
